---
// Text part of an "Over ons" photo block: overline, title, text and optional button.
interface Props {
  block: {
    overline?: string;
    title?: string;
    text?: string;
    buttonLabel?: string;
    buttonUrl?: string;
  };
}

const { block } = Astro.props;
---

{block.overline && <p class="section-overline mb-4">{block.overline}</p>}
{block.title && <h2 class="font-bold mb-5">{block.title}</h2>}
{
  block.text && (
    <p class="body-lg text-[var(--color-bordeaux-40)] whitespace-pre-line">
      {block.text}
    </p>
  )
}
{
  block.buttonLabel && block.buttonUrl && (
    <a href={block.buttonUrl} class="btn btn-secondary btn-lg mt-6">
      {block.buttonLabel}
    </a>
  )
}
