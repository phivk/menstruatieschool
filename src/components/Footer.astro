---
---

<footer class="bg-[var(--color-bordeaux)]">
  <div class="container-site grid md:grid-cols-4 gap-12 pt-14 pb-10">

    <!-- Brand -->
    <div>
      <div class="flex items-center gap-2 mb-4">
        <div class="w-6 h-6 rounded-full bg-[var(--color-amber)] flex items-center justify-center shrink-0">
          <div class="w-2 h-2 rounded-full bg-white"></div>
        </div>
        <span class="font-[Urbanist] font-bold text-[14px] text-white">De MenstruatieSchool</span>
      </div>
      <p class="type-caption text-[13px] leading-relaxed max-w-[180px]" style="color: var(--color-bordeaux-60)">
        Toegankelijke kennis over de menstruatiecyclus — van jong tot oud.
      </p>
    </div>

    <!-- Programma -->
    <div>
      <p class="type-overline mb-4" style="color: var(--color-bordeaux-60)">Programma</p>
      <ul class="flex flex-col gap-2">
        <li><a href="/#workshops" class="type-caption text-[14px] no-underline transition-colors" style="color: var(--color-bordeaux-40)">Workshops</a></li>
        <li><a href="#" class="type-caption text-[14px] no-underline transition-colors" style="color: var(--color-bordeaux-40)">Online lessen</a></li>
        <li><a href="#" class="type-caption text-[14px] no-underline transition-colors" style="color: var(--color-bordeaux-40)">Voor scholen</a></li>
        <li><a href="#" class="type-caption text-[14px] no-underline transition-colors" style="color: var(--color-bordeaux-40)">Voor werkgevers</a></li>
      </ul>
    </div>

    <!-- Organisatie -->
    <div>
      <p class="type-overline mb-4" style="color: var(--color-bordeaux-60)">Organisatie</p>
      <ul class="flex flex-col gap-2">
        <li><a href="/#over-ons" class="type-caption text-[14px] no-underline transition-colors" style="color: var(--color-bordeaux-40)">Over ons</a></li>
        <li><a href="#" class="type-caption text-[14px] no-underline transition-colors" style="color: var(--color-bordeaux-40)">Missie</a></li>
        <li><a href="#" class="type-caption text-[14px] no-underline transition-colors" style="color: var(--color-bordeaux-40)">Team</a></li>
        <li><a href="#" class="type-caption text-[14px] no-underline transition-colors" style="color: var(--color-bordeaux-40)">Contact</a></li>
      </ul>
    </div>

    <!-- Newsletter mini -->
    <div>
      <p class="type-overline mb-4" style="color: var(--color-bordeaux-60)">Nieuwsbrief</p>
      <p class="type-caption text-[13px] leading-relaxed mb-4" style="color: var(--color-bordeaux-60)">
        Blijf op de hoogte van nieuwe workshops.
      </p>
      <form data-placeholder="emailoctopus-footer" class="flex">
        <input
          type="email"
          placeholder="jij@voorbeeld.nl"
          required
          style="background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.10); border-right: none; border-radius: var(--radius-pill) 0 0 var(--radius-pill); padding: 9px 14px; color: #fff; font-family: var(--font-caption); font-size: 13px; outline: none; flex: 1; width: 0;"
        >
        <button
          type="submit"
          style="background: var(--color-amber); color: var(--color-bordeaux); border: none; padding: 9px 16px; border-radius: 0 var(--radius-pill) var(--radius-pill) 0; font-size: 16px; cursor: pointer; shrink: 0;"
        >→</button>
      </form>
    </div>

  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/5">
    <div class="container-site flex justify-between items-center py-4">
      <span class="type-caption text-[12px]" style="color: var(--color-bordeaux-60)">© 2025 De MenstruatieSchool</span>
      <div class="flex gap-5">
        <a href="#" class="type-caption text-[12px] no-underline" style="color: var(--color-bordeaux-60)">Privacy</a>
        <a href="#" class="type-caption text-[12px] no-underline" style="color: var(--color-bordeaux-60)">Voorwaarden</a>
      </div>
    </div>
  </div>
</footer>
