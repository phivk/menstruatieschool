---

<footer class="bg-[var(--color-bordeaux)]">
  <div class="container-site grid md:grid-cols-3 gap-12 pt-14 pb-10">
    <!-- Brand -->
    <div>
      <div class="flex items-center gap-2 mb-4">
        <div
          class="w-6 h-6 rounded-full bg-[var(--color-amber)] flex items-center justify-center shrink-0"
        >
          <div class="w-2 h-2 rounded-full bg-white"></div>
        </div>
        <span class="font-[Urbanist] font-bold text-[14px] text-white"
          >De MenstruatieSchool</span
        >
      </div>
      <p
        class="type-caption text-[13px] leading-relaxed max-w-[180px]"
        style="color: rgba(255,255,255,0.6)"
      >
        Toegankelijke kennis over de menstruatiecyclus — van jong tot oud.
      </p>
    </div>

    <!-- Programma -->
    <div>
      <p class="type-overline mb-4" style="color: rgba(255,255,255,0.6)">
        Programma
      </p>
      <ul class="flex flex-col gap-2">
        <li>
          <a
            href="/#workshops"
            class="type-caption text-[14px] no-underline transition-colors"
            style="color: rgba(255,255,255,0.75)">Workshops</a>
        </li>
        <li>
          <a
            href="#"
            class="type-caption text-[14px] no-underline transition-colors"
            style="color: rgba(255,255,255,0.75)">Online lessen</a>
        </li>
        <li>
          <a
            href="#"
            class="type-caption text-[14px] no-underline transition-colors"
            style="color: rgba(255,255,255,0.75)">Voor scholen</a>
        </li>
        <li>
          <a
            href="#"
            class="type-caption text-[14px] no-underline transition-colors"
            style="color: rgba(255,255,255,0.75)">Voor werkgevers</a>
        </li>
      </ul>
    </div>

    <!-- Organisatie -->
    <div>
      <p class="type-overline mb-4" style="color: rgba(255,255,255,0.6)">
        Organisatie
      </p>
      <ul class="flex flex-col gap-2">
        <li>
          <a
            href="/over-ons"
            class="type-caption text-[14px] no-underline transition-colors"
            style="color: rgba(255,255,255,0.75)">Over ons</a>
        </li>
        <li>
          <a
            href="#"
            class="type-caption text-[14px] no-underline transition-colors"
            style="color: rgba(255,255,255,0.75)">Missie</a>
        </li>
        <li>
          <a
            href="#"
            class="type-caption text-[14px] no-underline transition-colors"
            style="color: rgba(255,255,255,0.75)">Team</a>
        </li>
        <li>
          <a
            href="#"
            class="type-caption text-[14px] no-underline transition-colors"
            style="color: rgba(255,255,255,0.75)">Contact</a>
        </li>
      </ul>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/5">
    <div class="container-site flex justify-between items-center py-4">
      <span
        class="type-caption text-[12px]"
        style="color: rgba(255,255,255,0.6)"
        >© 2025 De MenstruatieSchool</span
      >
      <div class="flex gap-5">
        <a
          href="#"
          class="type-caption text-[12px] no-underline"
          style="color: rgba(255,255,255,0.6)">Privacy</a
        >
        <a
          href="#"
          class="type-caption text-[12px] no-underline"
          style="color: rgba(255,255,255,0.6)">Voorwaarden</a
        >
      </div>
    </div>
  </div>
</footer>
