---
import { Image } from "astro:assets";

// Photo from the "Over ons" photo blocks, or a placeholder when none is uploaded.
// `class` sets shape and aspect ratio on both the image and the placeholder.
interface Props {
  image?: string | null;
  alt?: string;
  class?: string;
}

const { image, alt = "", class: className } = Astro.props;
---

{
  image ? (
    <Image
      src={image}
      alt={alt}
      width={800}
      height={800}
      class:list={["w-full object-cover", className]}
    />
  ) : (
    <div
      class:list={[
        "w-full bg-[var(--color-amber-mist)] border border-[#F0D888] flex items-center justify-center",
        className,
      ]}
    >
      <div class="text-center p-8">
        <div class="w-12 h-12 rounded-full bg-[var(--color-amber)] opacity-30 mx-auto mb-3" />
        <span class="type-overline text-[var(--color-bordeaux-20)]">Foto</span>
      </div>
    </div>
  )
}
