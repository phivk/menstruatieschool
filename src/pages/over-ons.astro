---
import { createReader } from "@keystatic/core/reader";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import keystaticConfig from "../../keystatic.config";

const reader = createReader(process.cwd(), keystaticConfig);
const oo = await reader.singletons.overOns.read();

const borderColors = [
  "var(--color-amber)",
  "var(--color-blush)",
  "var(--color-vermilion)",
];

const photoBlocks = [oo.photoBlock1, oo.photoBlock2];
---

<BaseLayout
  title="Over ons — De MenstruatieSchool"
  description="Ontdek wie wij zijn en waarom we De MenstruatieSchool zijn gestart. We geloven dat kennis over je cyclus je leven kan veranderen."
>
  <!-- ── Page header ───────────────────────────────────────── -->
  <section class="bg-white border-b border-[var(--color-border-subtle)] py-16">
    <div class="container-site">
      <p class="section-overline mb-4">{oo.label}</p>
      <h1
        class="font-bold max-w-[560px]"
        set:html={oo.headline?.replace(/\n/g, "<br>")}
      />
    </div>
  </section>

  <!-- ── Content ───────────────────────────────────────────── -->
  <section
    class="bg-[var(--color-off-white)] border-b border-[var(--color-border-subtle)] py-12 md:py-20"
  >
    <div class="container-site">
      <div class="grid md:grid-cols-2 gap-16 items-start">
        <!-- Left: body text -->
        <div>
          {
            oo.body.map((paragraph, i) => (
              <p
                class:list={[
                  "body-lg text-[var(--color-bordeaux-40)]",
                  i < oo.body.length - 1 && "mb-4",
                ]}
              >
                {paragraph}
              </p>
            ))
          }
        </div>

        <!-- Right: value cards -->
        <div class="flex flex-col gap-3">
          {
            oo.values.map((value, i) => (
              <div
                class="value-card border-l-[3px]"
                style={`border-left-color: ${borderColors[i % borderColors.length]}`}
              >
                <div class="font-[Urbanist] font-bold text-[16px] text-[var(--color-bordeaux)] mb-1">
                  {value.title}
                </div>
                <p class="type-body text-[14px] text-[var(--color-bordeaux-40)] leading-relaxed">
                  {value.description}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ── Photos + text ─────────────────────────────────────── -->
  <section
    class="bg-white border-b border-[var(--color-border-subtle)] py-12 md:py-20"
  >
    <div class="container-site">
      <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-start">
        {
          photoBlocks.map((block) => (
            <figure>
              {block.image ? (
                <Image
                  src={block.image}
                  alt={block.alt}
                  width={800}
                  height={1000}
                  class="rounded-[var(--radius-xl)] w-full aspect-[4/5] object-cover"
                />
              ) : (
                <div class="rounded-[var(--radius-xl)] overflow-hidden bg-[var(--color-amber-mist)] border border-[#F0D888] aspect-[4/5] flex items-center justify-center">
                  <div class="text-center p-8">
                    <div class="w-16 h-16 rounded-full bg-[var(--color-amber)] opacity-30 mx-auto mb-4" />
                    <span class="type-overline text-[var(--color-bordeaux-20)]">
                      Foto · 4:5
                    </span>
                  </div>
                </div>
              )}
              {block.text && (
                <figcaption class="body-lg text-[var(--color-bordeaux-40)] mt-6 whitespace-pre-line">
                  {block.text}
                </figcaption>
              )}
            </figure>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
