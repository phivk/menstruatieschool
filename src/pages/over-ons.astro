---
import { createReader } from "@keystatic/core/reader";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import keystaticConfig from "../../keystatic.config";

const reader = createReader(process.cwd(), keystaticConfig);
const oo = await reader.singletons.overOns.read();

const borderColors = [
  "var(--color-amber)",
  "var(--color-blush)",
  "var(--color-vermilion)",
];

const photoBlocks = [oo.photoBlock1, oo.photoBlock2];
---

<BaseLayout
  title="Over ons — De MenstruatieSchool"
  description="Ontdek wie wij zijn en waarom we De MenstruatieSchool zijn gestart. We geloven dat kennis over je cyclus je leven kan veranderen."
>
  <!-- ── Page header ───────────────────────────────────────── -->
  <section class="bg-white border-b border-[var(--color-border-subtle)] py-16">
    <div class="container-site">
      <p class="section-overline mb-4">{oo.label}</p>
      <h1
        class="font-bold max-w-[560px]"
        set:html={oo.headline?.replace(/\n/g, "<br>")}
      />
    </div>
  </section>

  <!-- ── Content ───────────────────────────────────────────── -->
  <section
    class="bg-[var(--color-off-white)] border-b border-[var(--color-border-subtle)] py-12 md:py-20"
  >
    <div class="container-site">
      <div class="grid md:grid-cols-2 gap-16 items-start">
        <!-- Left: body text -->
        <div>
          {
            oo.body.map((paragraph, i) => (
              <p
                class:list={[
                  "body-lg text-[var(--color-bordeaux-40)]",
                  i < oo.body.length - 1 && "mb-4",
                ]}
              >
                {paragraph}
              </p>
            ))
          }
        </div>

        <!-- Right: value cards -->
        <div class="flex flex-col gap-3">
          {
            oo.values.map((value, i) => (
              <div
                class="value-card border-l-[3px]"
                style={`border-left-color: ${borderColors[i % borderColors.length]}`}
              >
                <div class="font-[Urbanist] font-bold text-[16px] text-[var(--color-bordeaux)] mb-1">
                  {value.title}
                </div>
                <p class="type-body text-[14px] text-[var(--color-bordeaux-40)] leading-relaxed">
                  {value.description}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ── Photos + text ─────────────────────────────────────── -->
  <!-- Round photo next to a rectangular text box; the second block mirrors the first -->
  <section
    class="bg-[var(--color-off-white)] border-b border-[var(--color-border-subtle)] py-12 md:py-20"
  >
    <div class="container-site flex flex-col gap-16 md:gap-24">
      {
        photoBlocks.map((block, i) => (
          <div
            class:list={[
              "flex flex-col md:items-center gap-8 md:gap-12 lg:gap-16",
              i % 2 === 1 ? "md:flex-row-reverse" : "md:flex-row",
            ]}
          >
            <div class="w-2/3 max-w-[320px] mx-auto md:mx-0 md:w-[30%] md:max-w-none shrink-0">
              {block.image ? (
                <Image
                  src={block.image}
                  alt={block.alt}
                  width={800}
                  height={800}
                  class="w-full aspect-square rounded-full object-cover"
                />
              ) : (
                <div class="rounded-full bg-[var(--color-amber-mist)] border border-[#F0D888] aspect-square flex items-center justify-center">
                  <div class="text-center p-8">
                    <div class="w-16 h-16 rounded-full bg-[var(--color-amber)] opacity-30 mx-auto mb-4" />
                    <span class="type-overline text-[var(--color-bordeaux-20)]">
                      Foto · rond
                    </span>
                  </div>
                </div>
              )}
            </div>

            <div class="bg-white border border-[var(--color-border-subtle)] shadow-[var(--shadow-2)] p-8 md:p-12 lg:p-16 md:flex-1">
              {block.overline && (
                <p class="section-overline mb-4">{block.overline}</p>
              )}
              <h2 class="font-bold mb-6">{block.title || "Titel"}</h2>
              <p class="body-lg text-[var(--color-bordeaux-40)] whitespace-pre-line">
                {block.text || "Tekst bij deze foto."}
              </p>
              {block.buttonLabel && block.buttonUrl && (
                <a href={block.buttonUrl} class="btn btn-secondary btn-lg mt-8">
                  {block.buttonLabel}
                </a>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
