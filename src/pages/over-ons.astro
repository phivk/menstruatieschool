---
import { createReader } from "@keystatic/core/reader";
import BaseLayout from "../layouts/BaseLayout.astro";
import AboutPhoto from "../components/AboutPhoto.astro";
import PhotoBlockText from "../components/PhotoBlockText.astro";
import keystaticConfig from "../../keystatic.config";

const reader = createReader(process.cwd(), keystaticConfig);
const oo = await reader.singletons.overOns.read();

const borderColors = [
  "var(--color-amber)",
  "var(--color-blush)",
  "var(--color-vermilion)",
];

const photoBlocks = [oo.photoBlock1, oo.photoBlock2];

// Per-block accent colours, following the site's amber / blush palette
const accents = [
  {
    mist: "bg-[var(--color-amber-mist)]",
    bar: "bg-[var(--color-amber)]",
    text: "text-[var(--color-amber-text)]",
  },
  {
    mist: "bg-[var(--color-blush-mist)]",
    bar: "bg-[var(--color-blush)]",
    text: "text-[var(--color-blush-text)]",
  },
];
---

<BaseLayout
  title="Over ons — De MenstruatieSchool"
  description="Ontdek wie wij zijn en waarom we De MenstruatieSchool zijn gestart. We geloven dat kennis over je cyclus je leven kan veranderen."
>
  <!-- ── Page header ───────────────────────────────────────── -->
  <section class="bg-white border-b border-[var(--color-border-subtle)] py-16">
    <div class="container-site">
      <p class="section-overline mb-4">{oo.label}</p>
      <h1
        class="font-bold max-w-[560px]"
        set:html={oo.headline?.replace(/\n/g, "<br>")}
      />
    </div>
  </section>

  <!-- ── Content ───────────────────────────────────────────── -->
  <section
    class="bg-[var(--color-off-white)] border-b border-[var(--color-border-subtle)] py-12 md:py-20"
  >
    <div class="container-site">
      <div class="grid md:grid-cols-2 gap-16 items-start">
        <!-- Left: body text -->
        <div>
          {
            oo.body.map((paragraph, i) => (
              <p
                class:list={[
                  "body-lg text-[var(--color-bordeaux-40)]",
                  i < oo.body.length - 1 && "mb-4",
                ]}
              >
                {paragraph}
              </p>
            ))
          }
        </div>

        <!-- Right: value cards -->
        <div class="flex flex-col gap-3">
          {
            oo.values.map((value, i) => (
              <div
                class="value-card border-l-[3px]"
                style={`border-left-color: ${borderColors[i % borderColors.length]}`}
              >
                <div class="font-[Urbanist] font-bold text-[16px] text-[var(--color-bordeaux)] mb-1">
                  {value.title}
                </div>
                <p class="type-body text-[14px] text-[var(--color-bordeaux-40)] leading-relaxed">
                  {value.description}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!--
    ── Photos + text ───────────────────────────────────────
    Design options A–D shown one below the other for comparison;
    keep the chosen one and remove the rest.
  -->

  <!-- Optie A: round photo beside a rectangular text box, mirrored -->
  <section
    class="bg-[var(--color-off-white)] border-b border-[var(--color-border-subtle)] py-12 md:py-20"
  >
    <div class="container-site">
      <p class="type-overline text-[var(--color-bordeaux-20)] mb-6 md:mb-7">
        Optie A · Ronde foto + tekstvak
      </p>
      <div class="flex flex-col gap-8 md:gap-9">
        {
          photoBlocks.map((block, i) => (
            <div
              class:list={[
                "flex flex-col md:items-center gap-6 md:gap-7 lg:gap-8",
                i % 2 === 1 ? "md:flex-row-reverse" : "md:flex-row",
              ]}
            >
              <div class="w-2/3 max-w-[320px] mx-auto md:mx-0 md:w-[30%] md:max-w-none shrink-0">
                <AboutPhoto
                  image={block.image}
                  alt={block.alt}
                  class="aspect-square rounded-full"
                />
              </div>
              <div class="bg-white border border-[var(--color-border-subtle)] shadow-[var(--shadow-2)] p-6 md:p-8 md:flex-1">
                <PhotoBlockText block={block} />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Optie B: two cards side by side, photo on top, accent bar -->
  <section
    class="bg-white border-b border-[var(--color-border-subtle)] py-12 md:py-20"
  >
    <div class="container-site">
      <p class="type-overline text-[var(--color-bordeaux-20)] mb-6 md:mb-7">
        Optie B · Kaarten naast elkaar
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {
          photoBlocks.map((block, i) => (
            <div class="bg-white border border-[var(--color-border)] rounded-[var(--radius-xl)] overflow-hidden flex flex-col">
              <AboutPhoto
                image={block.image}
                alt={block.alt}
                class="aspect-[4/3] border-0"
              />
              <div class:list={["h-1.5", accents[i].bar]} />
              <div class="p-6 md:p-7">
                <PhotoBlockText block={block} overlineClass={accents[i].text} />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Optie C: rounded photo on a coloured offset shape, text without a box -->
  <section
    class="bg-[var(--color-off-white)] border-b border-[var(--color-border-subtle)] py-12 md:py-20"
  >
    <div class="container-site">
      <p class="type-overline text-[var(--color-bordeaux-20)] mb-6 md:mb-7">
        Optie C · Foto met kleurvlak
      </p>
      <div class="flex flex-col gap-8 md:gap-10">
        {
          photoBlocks.map((block, i) => (
            <div
              class:list={[
                "flex flex-col md:items-center gap-7 lg:gap-9",
                i % 2 === 1 ? "md:flex-row-reverse" : "md:flex-row",
              ]}
            >
              <div class="relative md:w-[42%] shrink-0 mx-4 md:mx-0">
                <div
                  class:list={[
                    "absolute inset-0 rounded-[var(--radius-xl)]",
                    accents[i].mist,
                    i % 2 === 1
                      ? "-translate-x-4 translate-y-4"
                      : "translate-x-4 translate-y-4",
                  ]}
                />
                <AboutPhoto
                  image={block.image}
                  alt={block.alt}
                  class="relative aspect-[4/5] rounded-[var(--radius-xl)]"
                />
              </div>
              <div class="md:flex-1 max-w-[560px]">
                <PhotoBlockText block={block} overlineClass={accents[i].text} />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Optie D: photo and pastel text panel joined in one rounded block -->
  <section
    class="bg-white border-b border-[var(--color-border-subtle)] py-12 md:py-20"
  >
    <div class="container-site">
      <p class="type-overline text-[var(--color-bordeaux-20)] mb-6 md:mb-7">
        Optie D · Foto en gekleurd vlak
      </p>
      <div class="flex flex-col gap-6">
        {
          photoBlocks.map((block, i) => (
            <div
              class:list={[
                "flex flex-col rounded-[var(--radius-xl)] overflow-hidden",
                i % 2 === 1 ? "md:flex-row-reverse" : "md:flex-row",
              ]}
            >
              <div class="relative md:w-1/2 md:min-h-[400px]">
                <AboutPhoto
                  image={block.image}
                  alt={block.alt}
                  class="aspect-[4/3] md:aspect-auto md:absolute md:inset-0 md:h-full border-0"
                />
              </div>
              <div
                class:list={[
                  "md:w-1/2 p-6 md:p-8 flex flex-col items-start justify-center",
                  accents[i].mist,
                ]}
              >
                <PhotoBlockText block={block} overlineClass={accents[i].text} />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
