---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkshopCard from '../components/WorkshopCard.astro';

const workshops = await getCollection('workshops');
workshops.sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
---

<BaseLayout title="De MenstruatieSchool — Leer je cyclus begrijpen">

  <!-- ── Hero ─────────────────────────────────────────────── -->
  <section class="bg-white border-b border-[var(--color-border-subtle)] py-[72px]">
    <div class="container-site grid md:grid-cols-2 gap-16 items-center">

      <!-- Left col -->
      <div>
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 bg-[var(--color-amber-mist)] rounded-[var(--radius-pill)] px-4 py-1.5 mb-6">
          <div class="w-1.5 h-1.5 rounded-full bg-[var(--color-amber)]"></div>
          <span class="type-overline text-[var(--color-amber-dark)]">Laagdrempelig · In je buurt</span>
        </div>

        <!-- Headline -->
        <h1 class="font-bold mb-5">
          Leer je<br>
          <em class="not-italic text-[var(--color-blush-dark)]">eigen cyclus</em><br>
          begrijpen.
        </h1>

        <!-- Body -->
        <p class="body-lg text-[var(--color-charcoal-40)] mb-8 max-w-[440px]">
          Kwalitatieve workshops over de menstruatiecyclus — toegankelijk, zonder taboe, en in je eigen buurt.
        </p>

        <!-- CTAs -->
        <div class="flex flex-wrap gap-3 mb-12">
          <a href="#workshops" class="btn btn-primary btn-lg">Bekijk workshops</a>
          <a href="#over-ons" class="btn btn-outline btn-lg">Meer over ons</a>
        </div>

        <!-- Stats -->
        <div class="flex gap-8">
          <div>
            <div class="stat-number">2.400</div>
            <p class="type-caption text-[var(--color-charcoal-40)] text-[12px] mt-1 max-w-[120px] leading-snug">
              dagen menstrueert een vrouw gemiddeld
            </p>
          </div>
          <div>
            <div class="stat-number text-[var(--color-blush)]">80%</div>
            <p class="type-caption text-[var(--color-charcoal-40)] text-[12px] mt-1 max-w-[130px] leading-snug">
              ervaart hormoongerelateerde klachten
            </p>
          </div>
        </div>
      </div>

      <!-- Right col -->
      <div class="relative">
        <!-- Image placeholder -->
        <div class="rounded-[var(--radius-xl)] overflow-hidden bg-[var(--color-amber-mist)] border border-[#F0D888] aspect-[4/5] flex items-center justify-center">
          <div class="text-center p-8">
            <div class="w-16 h-16 rounded-full bg-[var(--color-amber)] opacity-30 mx-auto mb-4"></div>
            <span class="type-overline text-[var(--color-charcoal-20)]">Foto · 4:5</span>
          </div>
        </div>

        <!-- Floating stat card -->
        <div class="absolute -bottom-5 -left-5 bg-white rounded-[var(--radius-lg)] px-5 py-4 shadow-[var(--shadow-2)] border border-[var(--color-border-subtle)]">
          <div class="font-[Urbanist] font-bold text-[22px] text-[var(--color-charcoal)] leading-tight">6,5 jaar</div>
          <div class="type-caption text-[var(--color-charcoal-40)] text-[12px] mt-0.5">gemiddeld per vrouw</div>
        </div>

        <!-- Decorative blob -->
        <div class="absolute -top-4 -right-4 w-14 h-14 rounded-full bg-[var(--color-blush)] opacity-25"></div>
      </div>

    </div>
  </section>

  <!-- ── About / Manifesto ─────────────────────────────────── -->
  <section id="over-ons" class="bg-[var(--color-off-white)] border-b border-[var(--color-border-subtle)] py-20">
    <div class="container-site">
      <p class="section-overline mb-4">Onze missie</p>

      <div class="grid md:grid-cols-2 gap-16 items-start">

        <!-- Left: text -->
        <div>
          <h2 class="font-bold mb-5">
            Kennis die jou<br>in je kracht zet
          </h2>
          <p class="body-lg text-[var(--color-charcoal-40)] mb-4">
            Een groot deel van de last die menstruerende personen ervaren blijft onnodig lang onzichtbaar — door taboe, een gebrek aan kwalitatieve educatie en het normaliseren van klachten.
          </p>
          <p class="body-lg text-[var(--color-charcoal-40)]">
            Met De MenstruatieSchool bieden we toepasbare kennis die taboes doorbreekt. Op korte termijn meer rust en zelfvertrouwen. Op lange termijn betere gezondheid en emancipatie.
          </p>
        </div>

        <!-- Right: value cards -->
        <div class="flex flex-col gap-3">
          <div class="value-card border-l-[3px] border-l-[var(--color-amber)]">
            <div class="font-[Urbanist] font-bold text-[16px] text-[var(--color-charcoal)] mb-1">Laagdrempelig</div>
            <p class="type-body text-[14px] text-[var(--color-charcoal-40)] leading-relaxed">Workshops in je eigen buurt, voor iedereen.</p>
          </div>
          <div class="value-card border-l-[3px] border-l-[var(--color-blush)]">
            <div class="font-[Urbanist] font-bold text-[16px] text-[var(--color-charcoal)] mb-1">Kwalitatief</div>
            <p class="type-body text-[14px] text-[var(--color-charcoal-40)] leading-relaxed">Onderbouwde kennis, geen hype of taboe.</p>
          </div>
          <div class="value-card border-l-[3px] border-l-[var(--color-vermilion)]">
            <div class="font-[Urbanist] font-bold text-[16px] text-[var(--color-charcoal)] mb-1">Verbindend</div>
            <p class="type-body text-[14px] text-[var(--color-charcoal-40)] leading-relaxed">Meer taal, meer begrip, meer ruimte voor steun.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ── Quote band ─────────────────────────────────────────── -->
  <section class="bg-[#2A2018] py-[72px] text-center">
    <div class="container-site">
      <!-- Color bars -->
      <div class="flex gap-1.5 justify-center mb-7">
        <div class="w-3 h-[3px] rounded-full bg-[var(--color-amber)]"></div>
        <div class="w-3 h-[3px] rounded-full bg-[var(--color-blush)]"></div>
        <div class="w-3 h-[3px] rounded-full bg-[var(--color-vermilion)]"></div>
      </div>

      <blockquote class="max-w-[680px] mx-auto mb-6">
        <p class="type-display text-[clamp(18px,2.6vw,28px)] leading-relaxed text-[#F5F0E8] italic font-[200]">
          "Wanneer vrouwen beter begrijpen hoe hun cyclus werkt, ontstaat er meer rust, meer zelfvertrouwen — en meer ruimte voor het leven dat ze willen leiden."
        </p>
      </blockquote>

      <cite class="not-italic type-overline text-[var(--color-amber)]">De MenstruatieSchool</cite>
    </div>
  </section>

  <!-- ── Workshops ──────────────────────────────────────────── -->
  <section id="workshops" class="bg-white border-t border-[var(--color-border-subtle)] py-20">
    <div class="container-site">

      <!-- Section header -->
      <div class="flex items-end justify-between mb-10">
        <div>
          <p class="section-overline text-[var(--color-amber-dark)] mb-3">Aankomende programma's</p>
          <h2 class="font-bold">Workshops &amp; lessen</h2>
        </div>
        <a href="#" class="btn btn-outline btn-sm">Alle workshops →</a>
      </div>

      <!-- Cards grid -->
      <div class="grid md:grid-cols-2 gap-5">
        {workshops.map(workshop => (
          <WorkshopCard workshop={workshop} />
        ))}
      </div>
    </div>
  </section>

  <!-- ── Newsletter ─────────────────────────────────────────── -->
  <section class="bg-[var(--color-bg-inverse)] py-20">
    <div class="container-site max-w-[560px] text-center">
      <p class="section-overline text-[var(--color-amber)] mb-4">Blijf op de hoogte</p>
      <h2 class="font-bold text-white mb-4">Nieuwe workshops<br>als eerste weten?</h2>
      <p class="body-lg mb-8" style="color: var(--color-charcoal-60)">
        Schrijf je in voor de nieuwsbrief en ontvang updates over nieuwe workshops, kennis en agenda.
      </p>

      <form data-placeholder="emailoctopus" class="flex gap-2 max-w-[420px] mx-auto">
        <input
          type="email"
          placeholder="jij@voorbeeld.nl"
          required
          style="background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.12); color: #fff; flex: 1;"
        >
        <button type="submit" class="btn btn-primary shrink-0">Aanmelden</button>
      </form>
    </div>
  </section>

</BaseLayout>
