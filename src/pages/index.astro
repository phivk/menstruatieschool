---
import { getCollection } from "astro:content";
import { createReader } from "@keystatic/core/reader";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import WorkshopCard from "../components/WorkshopCard.astro";
import keystaticConfig from "../../keystatic.config";

const reader = createReader(process.cwd(), keystaticConfig);
const hp = await reader.singletons.homepagina.read();
const oo = await reader.singletons.overOns.read();

const workshops = await getCollection("workshops");
workshops.sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const featuredWorkshops = workshops.slice(0, 4);
---

<BaseLayout
  title="De MenstruatieSchool — Leer je cyclus begrijpen"
  description="Vergroot je kennis over je menstruatiecyclus met praktische workshops en lessen van De MenstruatieSchool. Voor iedereen die meer wil begrijpen over hormonen, cyclus en gezondheid."
>
  <!-- ── Hero ─────────────────────────────────────────────── -->
  <section
    class="bg-white border-b border-[var(--color-border-subtle)] py-12 md:py-[72px]"
  >
    <div class="container-site grid md:grid-cols-2 gap-16 items-center">
      <!-- Left col -->
      <div>
        <!-- Badge -->
        <div
          class="inline-flex items-center gap-2 bg-[var(--color-amber-mist)] rounded-[var(--radius-pill)] px-4 py-1.5 mb-6"
        >
          <div class="w-1.5 h-1.5 rounded-full bg-[var(--color-amber)]"></div>
          <span class="type-overline text-[var(--color-amber-text)]"
            >{hp.heroBadge}</span
          >
        </div>

        <!-- Headline -->
        <h1 class="font-bold mb-5">
          {hp.heroHeadlinePre}<br />
          <em class="not-italic text-[var(--color-blush-dark)]"
            >{hp.heroHeadlineEmphasis}</em
          ><br />
          {hp.heroHeadlinePost}
        </h1>

        <!-- Body -->
        <p
          class="body-lg text-[var(--color-bordeaux-40)] mb-8 md:max-w-[440px]"
        >
          {hp.heroBody}
        </p>

        <!-- CTAs -->
        <div class="flex flex-wrap gap-3 mb-12">
          <a href="#workshops" class="btn btn-primary btn-lg"
            >Bekijk workshops</a
          >
          <a href="#over-ons" class="btn btn-outline btn-lg">Meer over ons</a>
        </div>

        <!-- Stats -->
        <div class="flex gap-8">
          {
            hp.heroStats.map((stat, i) => (
              <div>
                <div
                  class:list={[
                    "stat-number",
                    i === 1 && "text-[var(--color-blush-dark)]",
                  ]}
                >
                  {stat.number}
                </div>
                <p class="type-caption text-[var(--color-bordeaux-40)] text-[12px] mt-1 max-w-[130px] leading-snug">
                  {stat.label}
                </p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Right col -->
      <div class="relative">
        {
          hp.heroImage ? (
            <Image
              src={hp.heroImage}
              alt=""
              width={800}
              height={1000}
              class="rounded-[var(--radius-xl)] w-full aspect-[4/5] object-cover"
            />
          ) : (
            <div class="rounded-[var(--radius-xl)] overflow-hidden bg-[var(--color-amber-mist)] border border-[#F0D888] aspect-[4/5] flex items-center justify-center">
              <div class="text-center p-8">
                <div class="w-16 h-16 rounded-full bg-[var(--color-amber)] opacity-30 mx-auto mb-4" />
                <span class="type-overline text-[var(--color-bordeaux-20)]">
                  Foto · 4:5
                </span>
              </div>
            </div>
          )
        }

        <!-- Floating stat card -->
        <div
          class="hidden md:block absolute -bottom-5 -left-5 bg-white rounded-[var(--radius-lg)] px-5 py-4 shadow-[var(--shadow-2)] border border-[var(--color-border-subtle)]"
        >
          <div
            class="font-[Urbanist] font-bold text-[22px] text-[var(--color-bordeaux)] leading-tight"
          >
            {hp.heroFloatingStatNumber}
          </div>
          <div
            class="type-caption text-[var(--color-bordeaux-40)] text-[12px] mt-0.5"
          >
            {hp.heroFloatingStatLabel}
          </div>
        </div>

        <!-- Decorative blob -->
        <div
          class="hidden md:block absolute -top-4 -right-4 w-14 h-14 rounded-full bg-[var(--color-blush)] opacity-25"
        >
        </div>
      </div>
    </div>
  </section>

  <!-- ── About / Manifesto ─────────────────────────────────── -->
  <section
    id="over-ons"
    class="bg-[var(--color-off-white)] border-b border-[var(--color-border-subtle)] py-12 md:py-20"
  >
    <div class="container-site">
      <p class="section-overline mb-4">{oo.label}</p>

      <div class="grid md:grid-cols-2 gap-16 items-start">
        <!-- Left: text -->
        <div>
          <h2
            class="font-bold mb-5"
            set:html={oo.headline?.replace(/\n/g, "<br>")}
          />
          {
            oo.body.map((paragraph, i) => (
              <p
                class:list={[
                  "body-lg text-[var(--color-bordeaux-40)]",
                  i < oo.body.length - 1 && "mb-4",
                ]}
              >
                {paragraph}
              </p>
            ))
          }
          {oo.linkLabel && <a href="/over-ons" class="btn btn-outline btn-sm mt-6">{oo.linkLabel}</a>}
        </div>

        <!-- Right: value cards -->
        {
          (() => {
            const borderColors = [
              "var(--color-amber)",
              "var(--color-blush)",
              "var(--color-vermilion)",
            ];
            return (
              <div class="flex flex-col gap-3">
                {oo.values.map((value, i) => (
                  <div
                    class="value-card border-l-[3px]"
                    style={`border-left-color: ${borderColors[i % borderColors.length]}`}
                  >
                    <div class="font-[Urbanist] font-bold text-[16px] text-[var(--color-bordeaux)] mb-1">
                      {value.title}
                    </div>
                    <p class="type-body text-[14px] text-[var(--color-bordeaux-40)] leading-relaxed">
                      {value.description}
                    </p>
                  </div>
                ))}
              </div>
            );
          })()
        }
      </div>
    </div>
  </section>

  <!-- ── Quote band ─────────────────────────────────────────── -->
  <section class="bg-[var(--color-bg-inverse)] py-12 md:py-[72px] text-center">
    <div class="container-site">
      <!-- Color bars -->
      <div class="flex gap-1.5 justify-center mb-7">
        <div class="w-3 h-[3px] rounded-full bg-[var(--color-amber)]"></div>
        <div class="w-3 h-[3px] rounded-full bg-[var(--color-blush)]"></div>
        <div class="w-3 h-[3px] rounded-full bg-[var(--color-vermilion)]"></div>
      </div>

      <blockquote class="max-w-[680px] mx-auto mb-6">
        <p
          class="type-display text-[clamp(18px,2.6vw,28px)] leading-relaxed text-[#F5F0E8] italic font-[200]"
        >
          "{hp.quoteText}"
        </p>
      </blockquote>

      <cite class="not-italic type-overline text-[var(--color-amber)]"
        >{hp.quoteAttribution}</cite
      >
    </div>
  </section>

  <!-- ── Workshops ──────────────────────────────────────────── -->
  <section
    id="workshops"
    class="bg-white border-t border-[var(--color-border-subtle)] py-12 md:py-20"
  >
    <div class="container-site">
      <!-- Section header -->
      <div
        class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between mb-10"
      >
        <div>
          <p class="section-overline text-[var(--color-amber-text)] mb-3">
            Aankomende programma's
          </p>
          <h2 class="font-bold">Workshops &amp; lessen</h2>
        </div>
        <a href="/workshops/" class="btn btn-outline btn-sm">Alle workshops →</a>
      </div>

      <!-- Cards grid -->
      <div class="grid md:grid-cols-2 gap-5">
        {featuredWorkshops.map((workshop) => <WorkshopCard workshop={workshop} />)}
      </div>
    </div>
  </section>

  <!-- ── Newsletter ─────────────────────────────────────────── -->
  <section class="bg-[var(--color-bg-inverse)] py-12 md:py-20">
    <div class="container-site max-w-[560px] text-center">
      <p class="section-overline text-[var(--color-amber)] mb-4">
        {hp.newsletterLabel}
      </p>
      <h2
        class="font-bold text-white mb-4"
        set:html={hp.newsletterHeadline?.replace(/\n/g, "<br>")}
      />
      <p class="body-lg mb-8" style="color: rgba(255,255,255,0.75)">
        {hp.newsletterBody}
      </p>

      <script
        is:inline
        async
        src="https://eocampaign1.com/form/0bd5758a-40dc-11f1-8eb9-0d2682659c97.js"
        data-form="0bd5758a-40dc-11f1-8eb9-0d2682659c97"></script>
    </div>
  </section>
</BaseLayout>
